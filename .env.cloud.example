# Dados da nuvem usados no deploy (fase 9). Copie para .env.cloud e preencha:
#   cp .env.cloud.example .env.cloud
# O arquivo .env.cloud não é versionado. Não cole estes valores em conversas nem em commits.

# Docker Hub (o login é feito à parte, com: docker login -u lourencodu)
DOCKERHUB_USER=lourencodu

# Azure
# Na assinatura Azure for Students, eastus2 e eastus não aceitam novos servidores de Azure SQL;
# canadacentral aceita e tem Container Apps e Functions Flex Consumption.
AZURE_LOCATION=canadacentral
AZURE_RESOURCE_GROUP=rg-puccrypto

# MongoDB Atlas: Database > Connect > Drivers, com usuário e senha do banco.
# Em Network Access, libere 0.0.0.0/0 (os endereços de saída do Azure variam).
MONGODB_URI=mongodb+srv://<usuario>:<senha>@puc-crypto-cluster.<id>.mongodb.net/?retryWrites=true&w=majority

# CloudAMQP: crie uma instância no plano gratuito (Little Lemur) e copie a "AMQP URL" com TLS (amqps://).
RABBITMQ_URI=amqps://<usuario>:<senha>@<host>.cloudamqp.com/<vhost>

# CoinGecko: chave do plano Demo (opcional; sem ela o limite de requisições é menor)
COINGECKO_API_KEY=

# Opcionais
# Tag das imagens no Docker Hub (padrão v1)
IMAGE_TAG=v1
# E-mail de contato exigido pelo API Management
APIM_PUBLISHER_EMAIL=
