{
  "openapi": "3.0.3",
  "info": {
    "title": "PUC Crypto API (Azure Backend)",
    "version": "1.0.0",
    "description": "API informativa de cotações de criptomoedas em Reais (BRL), métricas globais de mercado e perfil de usuário para a plataforma PUC Crypto, hospedada no Microsoft Azure.",
    "contact": {
      "name": "Equipe PUC Crypto",
      "email": "contato@puc-crypto.com.br"
    }
  },
  "servers": [
    {
      "url": "https://puc-crypto-api.azurewebsites.net/api",
      "description": "Servidor de Produção (Azure App Service / Functions)"
    },
    {
      "url": "http://localhost:7071/api",
      "description": "Servidor de Desenvolvimento Local (Azure Functions Core Tools)"
    }
  ],
  "paths": {
    "/cryptos": {
      "get": {
        "summary": "Listar cotações de criptomoedas em Reais (BRL)",
        "description": "Retorna a lista de criptomoedas disponíveis com cotações atualizadas em BRL, variações em 24h, métricas de capitalização e visão geral de mercado.",
        "operationId": "getCryptos",
        "tags": ["Criptomoedas"],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Termo de busca por nome ou ticker (ex. Bitcoin, SOL)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "Filtro por categoria do ativo",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["all", "layer1", "defi", "stablecoin", "meme", "nft"],
              "default": "all"
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "description": "Campo para ordenação",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["rank", "name", "priceBrl", "change24h", "marketCapBrl", "volume24hBrl"],
              "default": "rank"
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "Direção da ordenação",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["asc", "desc"],
              "default": "asc"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Quantidade máxima de registros retornados",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Número da página para paginação",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de cotações obtida com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CryptoListResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno no processamento do servidor Azure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/cryptos/{id}": {
      "get": {
        "summary": "Obter detalhes de uma criptomoeda",
        "description": "Retorna os dados completos e histórico recente de cotação de um criptoativo específico pelo seu ID.",
        "operationId": "getCryptoById",
        "tags": ["Criptomoedas"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador único da criptomoeda",
            "required": true,
            "schema": {
              "type": "string",
              "example": "bitcoin"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalhes da criptomoeda retornados com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": { "$ref": "#/components/schemas/CryptoAsset" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Criptomoeda não encontrada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "summary": "Obter dados do usuário autenticado",
        "description": "Retorna as informações do usuário autenticado via Bearer Token, incluindo preferências e lista de criptomoedas favoritas.",
        "operationId": "getMe",
        "tags": ["Usuário & Autenticação"],
        "security": [
          { "BearerAuth": [] },
          { "AzureApimKey": [] }
        ],
        "responses": {
          "200": {
            "description": "Dados do usuário retornados com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Não autorizado - Token ausente ou inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/me/watchlist": {
      "get": {
        "summary": "Listar criptomoedas favoritas do usuário",
        "description": "Retorna todos os itens salvos na lista de observação/favoritos do usuário autenticado.",
        "operationId": "getWatchlist",
        "tags": ["Favoritos / Watchlist"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Lista de favoritos retornada com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "total": { "type": "integer", "example": 3 },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/UserWatchlistItem" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Adicionar criptomoeda aos favoritos",
        "description": "Adiciona um novo ativo na lista de favoritos do usuário.",
        "operationId": "addWatchlistItem",
        "tags": ["Favoritos / Watchlist"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWatchlistRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Criptomoeda favoritada com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": { "$ref": "#/components/schemas/UserWatchlistItem" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dados de requisição inválidos.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/me/watchlist/{id}": {
      "delete": {
        "summary": "Remover criptomoeda dos favoritos",
        "description": "Remove um item da lista de favoritos pelo seu ID de registro.",
        "operationId": "removeWatchlistItem",
        "tags": ["Favoritos / Watchlist"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador do registro de favorito a ser removido",
            "required": true,
            "schema": {
              "type": "string",
              "example": "fav_1724792000"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Item removido dos favoritos com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "Ativo removido dos favoritos com sucesso." }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token de autenticação JWT informado no header Authorization (Bearer <token>)."
      },
      "AzureApimKey": {
        "type": "apiKey",
        "in": "header",
        "name": "Ocp-Apim-Subscription-Key",
        "description": "Chave de assinatura para consumo através do Azure API Management."
      }
    },
    "schemas": {
      "CryptoAsset": {
        "type": "object",
        "required": [
          "rank", "id", "name", "symbol", "iconUrl", "priceBrl",
          "change24h", "high24h", "low24h", "volume24hBrl", "marketCapBrl",
          "circulatingSupply", "sparkline7d"
        ],
        "properties": {
          "rank": { "type": "integer", "example": 1 },
          "id": { "type": "string", "example": "bitcoin" },
          "name": { "type": "string", "example": "Bitcoin" },
          "symbol": { "type": "string", "example": "BTC" },
          "iconUrl": { "type": "string", "format": "uri", "example": "https://assets.coingecko.com/coins/images/1/large/bitcoin.png" },
          "priceBrl": { "type": "number", "format": "double", "example": 348920.5 },
          "change24h": { "type": "number", "format": "double", "example": 3.92 },
          "high24h": { "type": "number", "format": "double", "example": 352100 },
          "low24h": { "type": "number", "format": "double", "example": 341500 },
          "volume24hBrl": { "type": "number", "format": "double", "example": 145890200 },
          "marketCapBrl": { "type": "number", "format": "double", "example": 6890450120300 },
          "circulatingSupply": { "type": "string", "example": "19.7M BTC" },
          "rating": { "type": "integer", "example": 5 },
          "lastModified": { "type": "string", "example": "21 Out, 2026" },
          "category": { "type": "string", "enum": ["layer1", "defi", "stablecoin", "meme", "nft"], "example": "layer1" },
          "sparkline7d": {
            "type": "array",
            "items": { "type": "number" },
            "example": [330000, 334000, 332000, 339000, 342500, 345000, 348920.5]
          }
        }
      },
      "MarketOverview": {
        "type": "object",
        "properties": {
          "totalMarketCapBrl": { "type": "number", "example": 14850000000000 },
          "totalVolume24hBrl": { "type": "number", "example": 485900000000 },
          "btcDominancePercent": { "type": "number", "example": 57.2 },
          "ethDominancePercent": { "type": "number", "example": 18.4 },
          "solDominancePercent": { "type": "number", "example": 8.5 },
          "marketTrend": { "type": "string", "enum": ["bullish", "bearish", "neutral"], "example": "bullish" },
          "marketChange24h": { "type": "number", "example": 2.7 }
        }
      },
      "CryptoListResponse": {
        "type": "object",
        "required": ["success", "timestamp", "currency", "total", "data"],
        "properties": {
          "success": { "type": "boolean", "example": true },
          "timestamp": { "type": "string", "format": "date-time", "example": "2026-08-27T23:05:00Z" },
          "currency": { "type": "string", "example": "BRL" },
          "total": { "type": "integer", "example": 10 },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CryptoAsset" }
          },
          "marketOverview": { "$ref": "#/components/schemas/MarketOverview" }
        }
      },
      "UserWatchlistItem": {
        "type": "object",
        "required": ["id", "cryptoId", "symbol", "name", "addedAt"],
        "properties": {
          "id": { "type": "string", "example": "fav_1" },
          "cryptoId": { "type": "string", "example": "bitcoin" },
          "symbol": { "type": "string", "example": "BTC" },
          "name": { "type": "string", "example": "Bitcoin (BTC)" },
          "iconUrl": { "type": "string", "format": "uri", "example": "https://assets.coingecko.com/coins/images/1/large/bitcoin.png" },
          "addedAt": { "type": "string", "example": "Adicionado recentemente" }
        }
      },
      "CreateWatchlistRequest": {
        "type": "object",
        "required": ["cryptoId", "symbol", "name"],
        "properties": {
          "cryptoId": { "type": "string", "example": "solana" },
          "symbol": { "type": "string", "example": "SOL" },
          "name": { "type": "string", "example": "Solana (SOL)" },
          "iconUrl": { "type": "string", "format": "uri", "example": "https://assets.coingecko.com/coins/images/4128/large/solana.png" }
        }
      },
      "UserPreferences": {
        "type": "object",
        "properties": {
          "currency": { "type": "string", "enum": ["BRL", "USD"], "example": "BRL" },
          "theme": { "type": "string", "enum": ["light", "dark"], "example": "light" },
          "language": { "type": "string", "enum": ["pt-BR", "en"], "example": "pt-BR" },
          "notificationsEnabled": { "type": "boolean", "example": true }
        }
      },
      "UserProfile": {
        "type": "object",
        "required": ["id", "name", "email", "avatarUrl", "role", "organization", "watchlist", "preferences"],
        "properties": {
          "id": { "type": "string", "example": "usr_puc_991823" },
          "name": { "type": "string", "example": "Eduardo Lourenço" },
          "email": { "type": "string", "format": "email", "example": "eduardo@puc-crypto.com.br" },
          "avatarUrl": { "type": "string", "format": "uri", "example": "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80" },
          "role": { "type": "string", "example": "Analista de Mercado" },
          "organization": { "type": "string", "example": "PUC Minas / Crypto Lab" },
          "watchlist": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/UserWatchlistItem" }
          },
          "preferences": { "$ref": "#/components/schemas/UserPreferences" },
          "createdAt": { "type": "string", "format": "date-time", "example": "2025-01-15T10:00:00Z" },
          "lastLogin": { "type": "string", "example": "Hoje às 20:00" }
        }
      },
      "MeResponse": {
        "type": "object",
        "required": ["success", "data"],
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": { "$ref": "#/components/schemas/UserProfile" },
          "unreadNotifications": { "type": "integer", "example": 2 },
          "serverRegion": { "type": "string", "example": "brazilsouth (Azure)" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["success", "error"],
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string", "example": "NOT_FOUND" },
              "message": { "type": "string", "example": "Criptomoeda informada não foi encontrada no catálogo." },
              "details": { "type": "string", "example": "O ID informado 'xyz' não corresponde a nenhum ativo registrado." }
            }
          }
        }
      }
    }
  }
}
