{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "bff": {
        "ClusterId": "bff",
        "Match": { "Path": "/api/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "default": { "Address": "http://localhost:5101" }
        }
      },
      "bff": {
        "Destinations": {
          "default": { "Address": "http://localhost:5100" }
        }
      }
    }
  }
}
