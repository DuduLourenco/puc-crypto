# Copie para .env antes de subir o ambiente: cp .env.example .env
# Valores apenas para desenvolvimento local.

# PostgreSQL do Identity
IDENTITY_DB_PASSWORD=identity_dev

# SQL Server do Catalog (exige letras maiúsculas, minúsculas e números)
MSSQL_SA_PASSWORD=PucCrypto_dev_123

# RabbitMQ
RABBITMQ_USER=puccrypto
RABBITMQ_PASSWORD=puccrypto_dev

# Chave de assinatura do JWT (HS256, mínimo de 32 bytes), usada pelo Identity (assina) e por quem valida o token
JWT_SIGNING_KEY=puccrypto-dev-only-signing-key-0123456789abcdef

# Chave exigida no cabeçalho X-Api-Key de POST /prices/collect do MarketData (usada pela Function agendada)
COLLECTOR_API_KEY=puccrypto-dev-collector-key

# Chave do plano Demo da CoinGecko (opcional; sem ela o limite de requisições é menor)
COINGECKO_API_KEY=

# Agendamento da coleta de preços pela Function (CRON de seis campos: segundo minuto hora dia mês dia-da-semana)
COLLECT_PRICES_SCHEDULE=0 */30 * * * *
