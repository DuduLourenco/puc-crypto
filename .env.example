# Copie para .env antes de subir o ambiente: cp .env.example .env
# Valores apenas para desenvolvimento local.

# PostgreSQL (usuário administrador do servidor)
POSTGRES_PASSWORD=postgres_dev

# Um usuário por serviço, com acesso apenas ao seu banco
IDENTITY_DB_PASSWORD=identity_dev
CATALOG_DB_PASSWORD=catalog_dev
MARKETDATA_DB_PASSWORD=marketdata_dev
PREDICTION_DB_PASSWORD=prediction_dev

# RabbitMQ
RABBITMQ_USER=puccrypto
RABBITMQ_PASSWORD=puccrypto_dev
