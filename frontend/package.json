{
  "name": "puccrypto-frontend",
  "version": "1.0.0",
  "description": "Microfrontends do PucCrypto: shell e remotes (auth, cryptos, dashboard) com Module Federation.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/run-all.mjs dev",
    "build": "npm run build -w @puccrypto/mfe-auth -w @puccrypto/mfe-cryptos -w @puccrypto/mfe-dashboard -w @puccrypto/shell",
    "preview": "node scripts/run-all.mjs preview",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:unit && npm run test:arch",
    "test:unit": "npm run test --workspaces --if-present",
    "test:arch": "depcruise packages --config .dependency-cruiser.cjs"
  },
  "devDependencies": {
    "@module-federation/vite": "1.23.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "dependency-cruiser": "17.4.3",
    "jsdom": "30.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1"
  }
}
