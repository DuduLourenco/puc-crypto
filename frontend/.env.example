# Copie para .env para mudar os padrões do desenvolvimento local: cp .env.example .env
# As variáveis são lidas no build (npm run build) e no servidor de desenvolvimento (npm run dev).

# Endereço do BFF visto pelo navegador (na nuvem, o API Gateway)
VITE_BFF_URL=http://localhost:5100

# Endereço do remoteEntry.js de cada microfrontend, usado pelo shell
MFE_AUTH_URL=http://localhost:5201/remoteEntry.js
MFE_CRYPTOS_URL=http://localhost:5202/remoteEntry.js
MFE_DASHBOARD_URL=http://localhost:5203/remoteEntry.js
