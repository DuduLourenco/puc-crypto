# Configurações da API Azure (Backend em Produção)
VITE_AZURE_API_URL=https://crypto-frontend.azurewebsites.net/api

# Chave de Assinatura Azure API Management (opcional)
VITE_AZURE_APIM_KEY=

# Token de autenticação simulado
VITE_API_AUTH_TOKEN=puc-crypto-session-token-azure

# Habilitar Fallback Automático para Mock se a API Azure estiver offline
VITE_USE_MOCK_FALLBACK=true
