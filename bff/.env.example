# Copie para .env para rodar o BFF fora do Docker: cp .env.example .env
# Valores apenas para desenvolvimento local, com os serviços do Compose da área de trabalho no ar.

PORT=5100
CORS_ORIGINS=*

IDENTITY_URL=http://localhost:5101
CATALOG_URL=http://localhost:5102
MARKETDATA_URL=http://localhost:5103

# Endereço da Azure Function, com o prefixo /api, e a chave da Function (x-functions-key)
FORECAST_URL=http://localhost:7071/api
FORECAST_FUNCTION_KEY=puccrypto-dev-function-key

# Mesma chave usada pelo Identity para assinar o JWT
JWT_SIGNING_KEY=puccrypto-dev-only-signing-key-0123456789abcdef
JWT_ISSUER=puccrypto-identity
JWT_AUDIENCE=puccrypto
